generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Table {
  id           Int           @id @default(autoincrement())
  tableNumber  String        @unique @map("table_number")
  capacity     Int
  status       TableStatus   @default(AVAILABLE)
  createdAt    DateTime      @default(now()) @map("created_at")
  reservations Reservation[]

  @@map("tables")
}

enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  BLOCKED
}

model Reservation {
  id      Int   @id @default(autoincrement())
  tableId Int   @map("table_id")
  table   Table @relation(fields: [tableId], references: [id], onDelete: Restrict)

  customerName    String            @map("customer_name")
  customerPhone   String            @map("customer_phone")
  reservationDate DateTime          @map("reservation_date")
  guestCount      Int               @map("guest_count")
  status          ReservationStatus @default(PENDING)
  createAt        DateTime          @default(now()) @map("created_at")
  guests          Guest[]

  @@unique([tableId, reservationDate])
  @@map("reservations")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Guest {
  id            Int         @id @default(autoincrement())
  reservationId Int         @map("reservation_id")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guestNumber   Int         @map("guest_number")
  orders        Order[]
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([reservationId, guestNumber])
  @@map("guests")
}

model Dish {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  category    String?
  available   Boolean  @default(true)
  orders      Order[]
  createdAt   DateTime @default(now()) @map("create_at")

  @@map("dishes")
}

model Order {
  id      Int   @id @default(autoincrement())
  guestId Int   @map("guest_id")
  guest   Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  dishId Int  @map("dish_id")
  dish   Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)

  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("orders")
}
