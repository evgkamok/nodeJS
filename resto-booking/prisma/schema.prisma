generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Table {
  id           Int           @id @default(autoincrement())
  tableNumber  String        @unique @map("table_number")
  capacity     Int
  createdAt    DateTime      @default(now()) @map("created_at")
  status       TableStatus   @default(AVAILABLE)
  reservations Reservation[]

  @@map("tables")
}

model Reservation {
  id              Int               @id @default(autoincrement())
  tableId         Int               @map("table_id")
  customerName    String            @map("customer_name")
  customerPhone   String            @map("customer_phone")
  reservationDate DateTime          @map("reservation_date")
  guestCount      Int               @map("guest_count")
  status          ReservationStatus @default(PENDING)
  createAt        DateTime          @default(now()) @map("created_at")
  guests          Guest[]
  table           Table             @relation(fields: [tableId], references: [id])

  @@index([tableId, reservationDate])
  @@map("reservations")
}

model Guest {
  id            Int         @id @default(autoincrement())
  reservationId Int         @map("reservation_id")
  guestNumber   Int         @map("guest_number")
  createdAt     DateTime    @default(now()) @map("created_at")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@unique([reservationId, guestNumber])
  @@map("guests")
}

model Dish {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  category    String?
  available   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("create_at")
  orders      Order[]

  @@map("dishes")
}

model Order {
  id        Int      @id @default(autoincrement())
  guestId   Int      @map("guest_id")
  dishId    Int      @map("dish_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@map("orders")
}

enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  BLOCKED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}
